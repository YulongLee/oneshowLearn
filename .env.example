API_PORT=8787
# Production payment-secret encryption: generate 32 random bytes as 64 hex characters.
# Keep the real value only on the server; back it up separately from the database.
# Merchant credentials are entered in /admin/payments, not in frontend environment files.
PAYMENT_CONFIG_ENCRYPTION_KEY=
APP_ORIGIN=http://127.0.0.1:4173
APP_URL=http://127.0.0.1:4173
DATABASE_PATH=./data/oneshowlearn.db
UPLOAD_DIR=./uploads
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=liyulong19950316@163.com
ADMIN_PASSWORD=replace-before-production
REGISTRATION_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_FROM=OneShowLearn <account@oneshowlearn.com>
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=account@oneshowlearn.com
EMAIL_SMTP_PASSWORD=replace-with-dedicated-smtp-password
EMAIL_DAILY_LIMIT=200
# Local testing only: writes verification messages to data/email outbox.
ALLOW_DEV_EMAIL_DELIVERY=true

# Server-only Alibaba Cloud Model Studio. Never use VITE_ for credentials.
AI_ENABLED=false
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=2400
AI_USER_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=300
# Production: independent 32-byte encryption key as 64 hex characters.
# Required to save API keys in the admin UI; do not rotate without re-encrypting saved keys.
AI_CONFIG_ENCRYPTION_KEY=
# Phone / WeChat login secrets are configured by the owner in /admin/login-settings.
# Production encryption key: 32 random bytes encoded as 64 hex characters.
# Keep it outside Git, and back it up separately from the database.
AUTH_CONFIG_ENCRYPTION_KEY=

# Private CMS attachments: local (legacy/default) or oss. Server-side only.
ASSET_STORAGE=local
OSS_BUCKET=projects-yulong
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_KEY_PREFIX=oneshowlearn/resources/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Server-only MinerU parsing; enable in /admin/parsing after setting this key.
# Never put provider credentials into VITE_ variables or Git.
MINERU_API_KEY=
